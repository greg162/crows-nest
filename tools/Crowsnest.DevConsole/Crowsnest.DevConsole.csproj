<Project Sdk="Microsoft.NET.Sdk">

  <!-- The bridge with no tray: Crowsnest.Host in a console, logging to the terminal. Stands in
       for Crowsnest.Tray (spec s8) until it exists. -->

  <ItemGroup>
    <ProjectReference Include="..\..\src\Crowsnest.Host\Crowsnest.Host.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
