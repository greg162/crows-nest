<Project Sdk="Microsoft.NET.Sdk">

  <!-- Spike 0(a). Throwaway. References the SDK install via %MSFS2024_SDK% instead of
       lib/simconnect/ until the redistribution question in spec s14 is answered. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Microsoft.FlightSimulator.SimConnect">
      <HintPath>$(MSFS2024_SDK)SimConnect SDK\lib\managed\Microsoft.FlightSimulator.SimConnect.dll</HintPath>
    </Reference>
    <None Include="$(MSFS2024_SDK)SimConnect SDK\lib\SimConnect.dll" Link="SimConnect.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
