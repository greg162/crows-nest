<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!--
    Each panel module's JSON (spec §5.8): *.parameters.json, View/*.view.json, *.demo.json.
    Resource names follow the folder (Crowsnest.Core.Panels.Com.View.com.view.json), which is
    how a module finds its own files.
  -->
  <ItemGroup>
    <EmbeddedResource Include="Panels\**\*.json" />
  </ItemGroup>

</Project>
