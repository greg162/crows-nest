<Window x:Class="Crowsnest.Tray.Diagnostics.DiagnosticsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Crowsnest.Tray.Diagnostics"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=local:DiagnosticsViewModel}"
        Title="Crowsnest diagnostics"
        Width="900" Height="560" MinWidth="640" MinHeight="400"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip"
        UseLayoutRounding="True">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="Visible" />
        <Style x:Key="Heading" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,14,0,6" />
        </Style>
        <Style x:Key="Quiet" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
        </Style>
        <!-- Numbers line up on the right. -->
        <Style x:Key="Number" TargetType="TextBlock">
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="MinWidth" Value="48" />
        </Style>
    </Window.Resources>

    <DockPanel Margin="12">

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Copy report" Padding="12,2" Click="OnCopyReport"
                    ToolTip="Copy everything here and the recent log, to paste into a bug report" />
            <Button Content="Open logs folder" Padding="12,2" Margin="8,0,0,0" Click="OnOpenLogs" />
            <Button Content="Close" Width="84" Margin="8,0,0,0" IsCancel="True" Click="OnClose" />
        </StackPanel>

        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="{Binding SimLine}" FontWeight="SemiBold" />

            <TextBlock Text="Devices" Style="{StaticResource Heading}" />
            <TextBlock Text="No devices connected" Style="{StaticResource Quiet}"
                       Visibility="{Binding HasNoDevices, Converter={StaticResource Visible}}" />
            <ListView ItemsSource="{Binding Devices}" Focusable="False"
                      Visibility="{Binding HasDevices, Converter={StaticResource Visible}}"
                      x:Name="DeviceList">
                <ListView.View>
                    <GridView AllowsColumnReorder="False">
                        <GridViewColumn Header="Device" Width="170" DisplayMemberBinding="{Binding Title}" />
                        <GridViewColumn Header="Port" Width="60" DisplayMemberBinding="{Binding Port}" />
                        <GridViewColumn Header="Panel" Width="90" DisplayMemberBinding="{Binding Panel}" />
                        <GridViewColumn Header="Firmware" Width="70" DisplayMemberBinding="{Binding Firmware}" />
                        <GridViewColumn Header="Connected" Width="90" DisplayMemberBinding="{Binding Connected}" />
                        <GridViewColumn Header="Round trip" Width="75" DisplayMemberBinding="{Binding RoundTrip}" />
                        <GridViewColumn Header="Frames in">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate><TextBlock Text="{Binding FramesIn}" Style="{StaticResource Number}" /></DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Out">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate><TextBlock Text="{Binding FramesOut}" Style="{StaticResource Number}" /></DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Ignored">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate><TextBlock Text="{Binding FramesIgnored}" Style="{StaticResource Number}" /></DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Restarts">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate><TextBlock Text="{Binding Restarts}" Style="{StaticResource Number}" /></DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>

            <!-- Ports another program holds, or that do not answer. -->
            <ItemsControl ItemsSource="{Binding Ports}" Margin="0,8,0,0"
                          Visibility="{Binding HasPorts, Converter={StaticResource Visible}}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate><TextBlock Text="{Binding}" Foreground="#9A5B00" /></DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <DockPanel Margin="0,14,0,6">
                <TextBlock Text="Log" FontWeight="SemiBold" />
                <TextBlock x:Name="LogNote" Style="{StaticResource Quiet}" Margin="10,0,0,0" FontSize="11" VerticalAlignment="Bottom" />
            </DockPanel>
        </StackPanel>

        <TextBox x:Name="LogBox" IsReadOnly="True" FontFamily="Consolas" FontSize="11"
                 TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                 IsUndoEnabled="False" />
    </DockPanel>
</Window>
