<Window x:Class="Crowsnest.Tray.Settings.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Crowsnest.Tray.Settings"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=local:SettingsViewModel}"
        Title="Crowsnest settings"
        Width="680" Height="460" MinWidth="560" MinHeight="380"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip"
        UseLayoutRounding="True">

    <Window.Resources>
        <local:VisibleWhenSetConverter x:Key="Visible" />
        <Style x:Key="Heading" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,14,0,6" />
        </Style>
        <Style x:Key="Quiet" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
        </Style>
        <!-- Green when plugged in, hollow when not. -->
        <Style x:Key="Dot" TargetType="Ellipse">
            <Setter Property="Width" Value="9" />
            <Setter Property="Height" Value="9" />
            <Setter Property="Stroke" Value="#8A8F98" />
            <Setter Property="StrokeThickness" Value="1.5" />
            <Setter Property="ToolTip" Value="Not connected" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsConnected}" Value="True">
                    <Setter Property="Fill" Value="#2EB872" />
                    <Setter Property="Stroke" Value="#2EB872" />
                    <Setter Property="ToolTip" Value="Connected" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <DockPanel Margin="12">

        <!-- The file did not parse: say so before the user saves over it. -->
        <Border DockPanel.Dock="Top" Margin="0,0,0,10" Padding="10,6" Background="#FFF4CE" BorderBrush="#E0C060" BorderThickness="1"
                Visibility="{Binding Problem, Converter={StaticResource Visible}}">
            <TextBlock TextWrapping="Wrap" Foreground="#3B2E00">
                <Run FontWeight="SemiBold" Text="settings.json has a mistake, so Crowsnest is using the settings from before it." />
                <Run Text="Saving here replaces the file. The mistake:" />
                <Run Text="{Binding Problem, Mode=OneWay}" />
            </TextBlock>
        </Border>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Cancel" Width="84" IsCancel="True" />
            <Button Content="Save" Width="84" Margin="8,0,0,0" Click="OnSave" />
        </StackPanel>

        <!-- Devices -->
        <DockPanel DockPanel.Dock="Left" Width="210">
            <TextBlock DockPanel.Dock="Top" Text="Devices" FontWeight="SemiBold" Margin="0,0,0,6" />
            <Button DockPanel.Dock="Bottom" Content="Forget device" HorizontalAlignment="Left" Margin="0,8,0,0" Padding="10,2"
                    IsEnabled="{Binding CanForget}" Click="OnForget"
                    ToolTip="Remove a device that is not plugged in from settings.json" />
            <ListBox ItemsSource="{Binding Devices}" SelectedItem="{Binding Selected}" HorizontalContentAlignment="Stretch">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="local:DeviceSettingsViewModel">
                        <Grid Margin="2,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Ellipse Style="{StaticResource Dot}" VerticalAlignment="Top" Margin="0,5,8,0" />
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Style="{StaticResource Quiet}" FontSize="11" TextTrimming="CharacterEllipsis">
                                    <Run Text="{Binding ShortId, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Summary, Mode=OneWay}" />
                                </TextBlock>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <!-- The selected device -->
        <Grid Margin="16,0,0,0">
            <TextBlock Style="{StaticResource Quiet}" TextWrapping="Wrap" VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center"
                       Visibility="{Binding HasNoDevices, Converter={StaticResource Visible}}"
                       Text="No devices yet. Plug one in and it will appear here." />

            <ScrollViewer VerticalScrollBarVisibility="Auto" DataContext="{Binding Selected}"
                          Visibility="{Binding Converter={StaticResource Visible}}">
                <StackPanel>
                    <TextBlock FontSize="16" FontWeight="SemiBold">
                        <Run Text="Device" /> <Run Text="{Binding ShortId, Mode=OneWay}" />
                    </TextBlock>
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                        <Ellipse Style="{StaticResource Dot}" Margin="0,0,6,0" />
                        <TextBlock Style="{StaticResource Quiet}" Text="{Binding Status}" />
                    </StackPanel>

                    <TextBlock Style="{StaticResource Heading}" Text="Name" />
                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" MaxLength="40" Padding="3,2" />

                    <TextBlock Style="{StaticResource Heading}" Text="Panel" />
                    <TextBlock Style="{StaticResource Quiet}" TextWrapping="Wrap" Margin="0,0,0,6"
                               Text="What this device shows. A long press on its knob pages through the panel's pages." />
                    <!-- A list for the single choice, drawn as radio buttons that follow the selection. -->
                    <ListBox ItemsSource="{Binding Choices}" SelectedItem="{Binding Panel}" BorderThickness="0" Background="Transparent"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ContentPresenter Margin="0,3" />
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="local:PanelChoiceViewModel">
                                <RadioButton Focusable="False"
                                             IsChecked="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}">
                                    <TextBlock>
                                        <Run Text="{Binding Label, Mode=OneWay}" FontWeight="SemiBold" />
                                        <Run Text="  " /><Run Text="{Binding Pages, Mode=OneWay}" Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
                                    </TextBlock>
                                </RadioButton>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock Style="{StaticResource Heading}" Text="Brightness" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="40" />
                        </Grid.ColumnDefinitions>
                        <!-- Minimum and Maximum before Value, or the value is clamped to the default range of 0 to 10. -->
                        <Slider Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" SmallChange="1" LargeChange="10"
                                Value="{Binding Brightness}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding Brightness}" TextAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</Window>
