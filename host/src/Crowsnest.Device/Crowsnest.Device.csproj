<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Crowsnest.Core\Crowsnest.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- SerialPort: the USB CDC transport (spec §6). -->
    <PackageReference Include="System.IO.Ports" Version="10.0.0" />
    <!-- CIM/WMI over Win32_PnPEntity: SerialPort.GetPortNames() gives no VID/PID (spec §6). -->
    <PackageReference Include="System.Management" Version="10.0.0" />
  </ItemGroup>

</Project>
