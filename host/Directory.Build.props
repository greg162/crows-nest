<Project>

  <!-- Settings shared by every project. Target frameworks stay per-project:
       Crowsnest.Core is net10.0 (BCL only, spec s4 dependency rule), the rest
       are net10.0-windows. -->

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- The app is English only, so don't ship the translated framework messages (WPF
         alone brings 13 languages). -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <!-- SimConnect's native DLL is x64 (spec s2 A6, s7.2). Nothing here ever
       runs as AnyCPU or x86. Each executable sets RuntimeIdentifier win-x64 in
       its own project: this file is read before a project sets OutputType, so a
       condition on it here never matches. -->
  <PropertyGroup>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <PropertyGroup>
    <Product>Crowsnest</Product>
    <Company>Crowsnest</Company>
    <Version>0.5.1</Version>
  </PropertyGroup>

</Project>
